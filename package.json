{
  "name": "finger-gundown",
  "private": true,
  "version": "0.1.1",
  "description": "A web 3D gesture-control game powered by Three.js & MediaPipe Holistic.",
  "author": "JohnnyDo0730",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3000 --open",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "electron:build": "rmdir /s /q dist_electron 2>nul & vite build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.johnnyd.finger-gundown",
    "productName": "FingerGundown",
    "artifactName": "${productName}-${version}.${ext}",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    }
  }
}